{
  "name": "ghostlight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ghostlight — a theatre for the dead. An interactive haunting where the stage is the interface.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "parity": "bun run scripts/parity.ts",
    "hooks": "bun run scripts/hooks-selftest.ts",
    "rehearse": "bun run scripts/rehearse.ts",
    "film": "bun run scripts/film.ts",
    "verify": "bun run typecheck && bun run parity && bun run hooks && bun run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
